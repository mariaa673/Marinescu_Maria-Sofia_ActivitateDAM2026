<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adaugă o mașină"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Marca" />

        <EditText
            android:id="@+id/etMarca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ex: Dacia"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="An fabricație" />

        <EditText
            android:id="@+id/etAn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ex: 2021"
            android:inputType="number"
            android:maxLength="4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Combustibil" />

        <Spinner
            android:id="@+id/spnCombustibil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Caroserie" />

        <RadioGroup
            android:id="@+id/rgCaroserie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checkedButton="@+id/rbSedan"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbSedan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sedan" />

            <RadioButton
                android:id="@+id/rbSuv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SUV" />

            <RadioButton
                android:id="@+id/rbHatchback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hatchback" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/cbGarantie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Are garanție" />

        <Switch
            android:id="@+id/swNoua"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mașină nouă" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Rating" />

        <RatingBar
            android:id="@+id/rbRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="0.5" />

        <Button
            android:id="@+id/btnSalveaza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Salvează" />
    </LinearLayout>
</ScrollView>